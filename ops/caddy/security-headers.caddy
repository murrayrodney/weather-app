# GENERATED by web/scripts/headers.mjs from web/security-headers.json. Do not edit by hand.
# Local variant: no HSTS, no upgrade-insecure-requests, no Cache-Control (the Caddyfile sets that per matcher).
header {
	Content-Security-Policy "style-src 'self'; style-src-attr 'unsafe-hashes' 'sha256-S8qMpvofolR8Mpjy4kQvEm7m1q8clzU4dfDH0AmvZjo='; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; media-src 'none'; worker-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "no-referrer"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
	Cross-Origin-Opener-Policy "same-origin"
	Cross-Origin-Resource-Policy "same-origin"
	X-Robots-Tag "noindex, nofollow"
}
