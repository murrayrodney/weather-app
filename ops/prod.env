# Non-secret production values for the runbook (docs/DEPLOY.md). Load once per terminal: `. ops/prod.env`
# Nothing secret goes here (the repo is public): secrets are read with `op read "op://$OP_VAULT/<item>/<field>"`.
# Personal values (station MAC, coordinates, emails) are never committed; the runbook sets them per session.
export PROJECT_REF=ymddigypalbplwbckkxp
export POOLER_HOST=aws-0-us-west-1.pooler.supabase.com
export SITE_ORIGIN=https://integrated-awn-weather.netlify.app
export SUPABASE_URL="https://$PROJECT_REF.supabase.co"
export OP_VAULT=Development
# bootstrap login as postgres over the session pooler; the password comes from PGPASSWORD for one command only
export POSTGRES_POOLER_URL="postgresql://postgres.$PROJECT_REF@$POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=backend/certs/supabase-ca.crt"
